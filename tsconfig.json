{
    "compilerOptions": {
        "target": "ES5",
        "module": "commonjs",
        "lib": ["ES5", "ES2015.Promise", "DOM"],
        "outDir": "dist",
        "rootDir": "src",
        "declaration": true,
        "emitDeclarationOnly": true,
        "strict": true,
        "skipLibCheck": true
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules", "test"],
    "ts-node": {
        "transpileOnly": true,
        "compilerOptions": {
            "emitDeclarationOnly": false
        }
    }
}
